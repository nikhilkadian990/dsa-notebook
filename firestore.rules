rules_version = '2';

// DSA Notebook: per-user private data. Anonymous auth is used so there is no
// visible login wall; every document lives under the authenticated user's uid.
service cloud.firestore {
  match /databases/{database}/documents {

    // A user may only reach their own subtree.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == uid;
    }

    // Public, machine-readable index material generated by `npm run sync-public`.
    // Read-only for the world; written only by the owner from the console/CLI.
    match /public/{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
